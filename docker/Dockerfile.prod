# ==============================================================================
# Multi-Stage Production Dockerfile for EVM C++ Listener
# ==============================================================================
# Stage 1: Build & link stripped binary using Conan 2.x + GCC 12
# Stage 2: Minimal runtime image based on Debian Bookworm Slim + tini
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/devcontainers/cpp:1-bookworm AS builder

WORKDIR /build

# Install build toolchain and Python/Conan dependencies matching .devcontainer/Dockerfile
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        ca-certificates \
        uuid-dev \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir --break-system-packages 'conan==2.*' \
    && conan profile detect --force

# Copy single-source version, Conan recipe, and profiles first (layer caching)
COPY VERSION conanfile.py conan.lock* ./
COPY conan/ ./conan/

# Install Release dependencies
RUN conan install . --build=missing -pr:a=conan/profiles/release -s build_type=Release

# Copy source tree
COPY CMakeLists.txt ./
COPY evm_listener/ ./evm_listener/

# Build and strip Release executable (-Wno-restrict and -Wno-maybe-uninitialized work around GCC 12 -O3 false positives in basic_string.h and std::variant)
ARG VERSION
RUN ln -sf build/Release/generators/CMakePresets.json CMakeUserPresets.json \
    && cmake --preset conan-release \
        -DEVML_BUILD_TESTS=OFF \
        -DEVML_SANITIZE=OFF \
        -DCMAKE_CXX_FLAGS_RELEASE="-O3 -DNDEBUG -Wno-restrict -Wno-maybe-uninitialized" \
        -DEVML_GIT_DESCRIBE="${VERSION:-v$(cat VERSION)}" \
    && cmake --build --preset conan-release --parallel 4 \
    && strip --strip-unneeded build/Release/evm_listener/evm_listener

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# System runtime dependencies: CA certs for TLS verification, tini as PID 1, libstdc++6
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged service user, spill directory, and config directory
RUN useradd -u 10001 -m -s /bin/false evml \
    && mkdir -p /tmp/evml-spill /app/config \
    && chown -R evml:evml /tmp/evml-spill /app

USER evml
WORKDIR /home/evml

# Copy compiled binary and default configuration
COPY --from=builder /build/build/Release/evm_listener/evm_listener /usr/local/bin/evm_listener
COPY --chown=evml:evml evm_listener/config/ /app/config/

# Prometheus metrics / ops HTTP port
EXPOSE 9464

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
    CMD ["/bin/bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/${PORT:-9464} && printf 'GET /healthz HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && head -n 1 <&3 | grep -q ' 200 '"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/evm_listener"]
CMD ["--config", "/app/config/base.toml"]
