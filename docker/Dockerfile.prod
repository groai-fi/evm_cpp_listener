# ==============================================================================
# Multi-Stage Production Dockerfile for EVM C++ Listener
# ==============================================================================
# Stage 1: Build & link stripped binary using Conan 2.x + GCC 12
# Stage 2: Minimal runtime image (~80MB) based on Debian Bookworm Slim
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Builder
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/devcontainers/cpp:1-bookworm AS builder

WORKDIR /build

# Ensure Conan 2.x is present and default profile generated
RUN pip3 install --no-cache-dir --break-system-packages 'conan==2.*' \
    && conan profile detect --force

# Copy single-source version, Conan recipe, and profiles first (layer caching)
COPY VERSION conanfile.py conan.lock* ./
COPY conan/ ./conan/

# Install Release dependencies
RUN conan install . --build=missing -pr:a=conan/profiles/release -s build_type=Release

# Copy source tree
COPY CMakeLists.txt ./
COPY evm_listener/ ./evm_listener/

# Build and strip Release executable
ARG VERSION
RUN cmake --preset conan-release \
        -DEVML_BUILD_TESTS=OFF \
        -DEVML_BUILD_COMMON=OFF \
        -DEVML_SANITIZE=OFF \
        -DEVML_GIT_DESCRIBE="${VERSION:-v$(cat VERSION)}" \
    && cmake --build --preset conan-release --parallel 4 \
    && strip --strip-unneeded build/Release/evm_listener/evm_listener

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# System runtime dependencies: CA certs for SSL TLS, tzdata for timestamps, curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libstdc++6 \
        tzdata \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged service user and spill directory
RUN useradd -u 10001 -m -s /bin/false evml \
    && mkdir -p /tmp/evml-spill \
    && chown evml:evml /tmp/evml-spill

USER evml
WORKDIR /home/evml

# Copy compiled binary from builder
COPY --from=builder /build/build/Release/evm_listener/evm_listener /usr/local/bin/evm_listener

# Prometheus metrics port
EXPOSE 9464

ENTRYPOINT ["/usr/local/bin/evm_listener"]
