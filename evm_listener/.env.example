# evm_listener: configuration reference. Placeholders only; real values live in evm_listener/.env
# (gitignored) locally and in Railway service variables in production. The loader walks up from the
# cwd over .env, .env.local.dev, .env.local and never overwrites variables that are already set.

# --- Base providers --------------------------------------------------------------------------
# A provider is ENABLED iff its variable is set (orders are defined in config/base.toml).
#   WS chain:      QuickNode -> Infura -> Alchemy
#   getLogs chain: Infura -> Alchemy -> Ankr -> public mainnet.base.org -> QuickNode
BASE_RPC_URL_QUICKNODE=https://<name>.base-mainnet.quiknode.pro/<QUICKNODE_TOKEN>/
BASE_WSS_URL_QUICKNODE=wss://<name>.base-mainnet.quiknode.pro/<QUICKNODE_TOKEN>/
BASE_RPC_URL=https://base-mainnet.infura.io/v3/<INFURA_PROJECT_ID>
BASE_WSS_URL=wss://base-mainnet.infura.io/ws/v3/<INFURA_PROJECT_ID>
BASE_RPC_URL_ALCHEMY=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
BASE_WSS_URL_ALCHEMY=wss://base-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
BASE_RPC_URL_ANKR=https://rpc.ankr.com/base/<ANKR_KEY>

# --- Ethereum mainnet (future) ---------------------------------------------------------------
MAINNET_RPC_URL=
MAINNET_WSS_URL=
MAINNET_RPC_URL_ALCHEMY=
MAINNET_WSS_URL_ALCHEMY=

# --- Sink / ops ------------------------------------------------------------------------------
# Local Docker: redis://redis:6379/0 (set by the devcontainer compose). Railway: ${{Redis.REDIS_URL}}
REDIS_URL=
# a | b ; defaults to the hostname
EVML_HOST_ID=
# n8n "EVM Listener Alert Webhook" -> Slack. The token is sent as header X-API-Key.
N8N_ALERT_WEBHOOK_URL=
N8N_ALERT_WEBHOOK_TOKEN=
# healthchecks.io dead-man's switch; the leader pings it every 60 s. Empty = disabled (startup WARN).
DEADMAN_PING_URL=https://hc-ping.com/<CHECK_UUID>
