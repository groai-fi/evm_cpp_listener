{
  "name": "evm_cpp_listener",

  // Build/runtime settings (SYS_PTRACE, seccomp, ipc) live in docker-compose.yml
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspaces/evm_cpp_listener",

  // Forward container ports to host machine (9464: metrics/health). Redis is reached as redis:6379 inside the compose network.
  "forwardPorts": [9464],

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "C_Cpp.intelliSenseEngine": "disabled",
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.exportCompileCommandsFile": true
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "dwenegar.vscode-luacheck"
      ]
    }
  },

  "remoteUser": "vscode"
}